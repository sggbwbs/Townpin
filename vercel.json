{
  "cleanUrls": true,
  "regions": ["arn1"],
  "rewrites": [
    { "source": "/pin/:id", "destination": "/api/pin/:id" },
    { "source": "/board/:slug", "destination": "/" },
    { "source": "/oulu", "destination": "/" },
    { "source": "/helsinki", "destination": "/" },
    { "source": "/api/board", "destination": "/api/data?endpoint=board" },
    { "source": "/api/feed", "destination": "/api/data?endpoint=feed" },
    { "source": "/api/feedback", "destination": "/api/data?endpoint=feedback" },
    { "source": "/api/site-feedback", "destination": "/api/data?endpoint=site-feedback" },
    { "source": "/api/user/:action", "destination": "/api/data?endpoint=user&action=:action" }
  ],
  "crons": [
    { "path": "/api/maintenance", "schedule": "0 4 * * *" },
    { "path": "/api/maintenance", "schedule": "0 3 * * 0" }
  ]
}
