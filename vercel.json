{
  "cleanUrls": true,
  "regions": ["arn1"],
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/pin/:id", "destination": "/api/pin/:id" },
    { "source": "/board/:slug", "destination": "/" },
    { "source": "/oulu", "destination": "/" },
    { "source": "/helsinki", "destination": "/" },
    { "source": "/api/board", "destination": "/api/data?endpoint=board" },
    { "source": "/api/feed", "destination": "/api/data?endpoint=feed" },
    { "source": "/api/feedback", "destination": "/api/data?endpoint=feedback" },
    { "source": "/api/site-feedback", "destination": "/api/data?endpoint=site-feedback" },
    { "source": "/api/track-click", "destination": "/api/data?endpoint=track-click" },
    { "source": "/api/today-card-sponsor", "destination": "/api/data?endpoint=today-card-sponsor" },
    { "source": "/api/user/:action", "destination": "/api/data?endpoint=user&action=:action" },
    { "source": "/api/notifications/subscribe", "destination": "/api/notifications?endpoint=subscribe" },
    { "source": "/api/notifications/confirm", "destination": "/api/notifications?endpoint=confirm" },
    { "source": "/api/notifications/unsubscribe", "destination": "/api/notifications?endpoint=unsubscribe" }
  ],
  "crons": [
    { "path": "/api/maintenance", "schedule": "0 4 * * *" },
    { "path": "/api/maintenance", "schedule": "0 3 * * 0" },
    { "path": "/api/notifications?endpoint=send-digest", "schedule": "*/15 * * * *" }
  ]
}
